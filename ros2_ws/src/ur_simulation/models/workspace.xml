<mujoco model="workspace">
  <statistic center="0.4 0 0.4" extent="1" />

  <option timestep="0.002" integrator="implicitfast" cone="elliptic" impratio="10" />

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0 0 0" />
    <rgba haze="0.15 0.25 0.35 1" />
    <global azimuth="120" elevation="-20" offwidth="1280" offheight="720" />
    <quality shadowsize="2048" />
    <map shadowclip="0.5" fogstart="5" fogend="10" />
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072" />
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300" />
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2" />
    <material name="table" rgba="0.3 0.3 0.3 1" />
    <mesh name="table" file="table.obj" />
  </asset>

  <contact>
    <!-- the shoulder capsule can overlap the table top by a few mm where the robot is mounted -->
    <exclude body1="shoulder_link" body2="table" />
  </contact>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true" />
    <geom name="floor" size="0 0 0.001" type="plane" pos="0 0 -0.925" material="groundplane" />

    <!-- Robot base sits at the world origin; the table top is 0.025 m below it.
         The collision box approximates the table top, the mesh is visual only. -->
    <body name="table" pos="-1.24 -0.22 -0.925" quat="0.707107 0 0 -0.707107">
      <geom name="table_visual" type="mesh" mesh="table" material="table" contype="0" conaffinity="0" group="2" />
      <geom name="table_collision" type="box" size="0.45 0.76 0.1" pos="-0.37 0.68 0.8" rgba="0.3 0.3 0.3 1"
        friction="0.9 0.2 0.05" group="3" />
    </body>
  </worldbody>
</mujoco>
